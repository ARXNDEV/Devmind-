  "info": {
    "title": "DevMind API",
    "description": "DevMind AI — public product API",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "organizationName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "pattern": "^\\S(.*\\S)?$"
          }
        },
        "required": [
          "organizationName",
          "name",
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "AuthOrgDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "organization": {
            "$ref": "#/components/schemas/AuthOrgDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user",
          "organization"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "createdAt"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "RepositoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "github",
              "gitlab",
              "bitbucket",
              "generic_git",
              "local"
            ],
            "type": "string"
          },
          "cloneUrl": {
            "type": "string"
          },
          "defaultBranch": {
            "type": "string"
          },
          "indexStatus": {
            "type": "string"
          },
          "indexedCommitSha": {
            "type": "string",
            "nullable": true
          },
          "hasCredentials": {
            "type": "boolean"
          },
          "lastIndexedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "provider",
          "cloneUrl",
          "defaultBranch",
          "indexStatus",
          "indexedCommitSha",
          "hasCredentials",
          "lastIndexedAt",
          "createdAt"
        ]
      },
      "CreateRepositoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "gitlab",
              "bitbucket",
              "generic_git",
              "local"
            ]
          },
          "cloneUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "defaultBranch": {
            "type": "string",
            "maxLength": 255
          },
          "credentials": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "name",
          "provider",
          "cloneUrl"
        ]
      }
    }
  }
}