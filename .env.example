# ─── DevMind environment template ─────────────────────────────────────────────
# Copy to .env for local dev. Every variable is validated at service boot;
# missing/invalid values fail fast. NEVER commit a real .env.

# ── Infrastructure (docker-compose defaults; override for pilots) ─────────────
POSTGRES_PASSWORD=devmind_dev
NEO4J_PASSWORD=devmind_dev_neo4j
MINIO_ROOT_USER=devmind
MINIO_ROOT_PASSWORD=devmind_dev_minio

# ── apps/api (NestJS) ──────────────────────────────────────────────────────────
API_PORT=4000
API_DATABASE_URL=postgres://api_service:api_dev_password@localhost:5432/devmind
# Release-step credential used only by db:migrate (DDL rights).
API_MIGRATION_DATABASE_URL=postgres://migrator:migrator_dev_password@localhost:5432/devmind
API_REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 48
API_JWT_SECRET=change_me_dev_only_generate_with_openssl_rand
API_JWT_ACCESS_TTL=900
API_JWT_REFRESH_TTL=1209600
# AES-256-GCM key for encrypting integration credentials. Generate with:
#   openssl rand -base64 32
API_CREDENTIAL_KEY=change_me_generate_with_openssl_rand_base64_32
# Shared secret authenticating api <-> code-intel internal traffic.
INTERNAL_SERVICE_TOKEN=change_me_internal_dev_token
CODE_INTEL_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# ── services/code-intel (FastAPI) ──────────────────────────────────────────────
CI_PORT=8000
CI_DATABASE_URL=postgres://codeintel_service:codeintel_dev_password@localhost:5432/devmind
CI_REDIS_URL=redis://localhost:6379
CI_QDRANT_URL=http://localhost:6333
CI_NEO4J_URL=bolt://localhost:7687
CI_NEO4J_USER=neo4j
CI_NEO4J_PASSWORD=devmind_dev_neo4j
CI_S3_ENDPOINT=http://localhost:9000
CI_S3_ACCESS_KEY=devmind
CI_S3_SECRET_KEY=devmind_dev_minio
CI_S3_BUCKET_SNAPSHOTS=devmind-snapshots
CI_S3_BUCKET_ARTIFACTS=devmind-artifacts
API_BASE_URL=http://localhost:4000
# Same value as INTERNAL_SERVICE_TOKEN above.
CI_INTERNAL_SERVICE_TOKEN=change_me_internal_dev_token

# ── Local model serving (ADR-0008): self-hosted Ollama, no API keys ───────────
CI_MODEL_BACKEND=ollama
CI_OLLAMA_URL=http://localhost:11434
# Generation model. Default qwen2.5-coder:7b; on CPU-only VMs drop to
# qwen2.5-coder:3b or :1.5b. Tier overrides below default to this if unset.
CI_LLM_MODEL=qwen2.5-coder:7b
CI_LLM_MODEL_REASONING=
CI_LLM_MODEL_FAST=
# Embedding model + dimension. Dimension is fixed at first index — changing
# the embedding model later requires a re-index (ADR-0008).
CI_EMBED_MODEL=nomic-embed-text
CI_EMBED_DIM=768

# ── apps/web (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
