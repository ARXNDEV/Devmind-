{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      { "include": "database/migrations/**/*.sql", "outDir": "dist" },
      { "include": "database/migrations/**/*.json", "outDir": "dist" }
    ],
    "watchAssets": false
  }
}
